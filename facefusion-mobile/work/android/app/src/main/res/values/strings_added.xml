<!--
  Strings referenced by the 0.9.41 sources that were missing from the resource set this
  build was assembled from, plus the strings for the occlusion / head-turn / motion options.
  English only: the other locales fall back to these until they are translated.
-->
<resources>
    <!-- Occlusion, region masks, head-turn fade, motion -->
    <string name="opt_occlusion">Occlusion mask</string>
    <string name="opt_occlusion_hint">Keeps the swap off anything in front of the face: food, hands, cups, a microphone, hair. Uses the XSeg model on the GPU or CPU.</string>
    <string name="opt_region">Face parser mask</string>
    <string name="opt_region_hint">Swaps only skin, eyes, brows, nose and lips (BiSeNet). Hair, ears and neck stay original.</string>
    <string name="opt_keep_mouth">Keep original mouth inside</string>
    <string name="opt_keep_mouth_hint">Teeth, tongue and whatever is in the mouth stay as filmed. Best for eating and talking.</string>
    <string name="opt_pose_fade">Fade out on big head turns</string>
    <string name="opt_pose_fade_hint">When the head turns too far left, right, up or down for the swapper, the original face shows through smoothly instead of a stretched one.</string>
    <string name="opt_pose_fade_start">Start fading at</string>
    <string name="opt_pose_fade_start_hint">Head turn where the fade begins. The swap is gone 20° later. Lower is safer, higher keeps more of the swap.</string>
    <string name="opt_motion_smooth">Motion smoothing</string>
    <string name="opt_motion_smooth_hint">Video and Live: steadies the face alignment between frames and keeps motion-blurred faces swapped during fast movement.</string>
    <string name="opt_detect_rotated">Find rotated faces</string>
    <string name="opt_detect_rotated_hint">Also looks for heads turned sideways or upside down (90°, 180°, 270°). Slower on frames without a face.</string>

