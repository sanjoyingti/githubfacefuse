rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // UPI QR codes: only group admins upload, any signed-in member can view.
    match /groups/{chatId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.admins
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
