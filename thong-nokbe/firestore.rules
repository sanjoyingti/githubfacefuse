rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // Free version: the phone number comes from the user's registered profile (claimed once, see phoneIndex).
    function myPhone() {
      let p = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(p) ? get(p).data.phone : '';
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function chatData(chatId) { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
    function isMemberOf(chatId) { return signedIn() && me() in chatData(chatId).members; }
    function isAdminOf(chatId) {
      let c = chatData(chatId);
      return signedIn() && c.type == 'group' && me() in c.admins;
    }

    // ---- Users: everyone signed in can look people up (to match contacts), only you edit yourself.
    // A phone number can be registered by one account only (phoneIndex), and can't be changed afterwards.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && me() == uid
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[+][0-9]{8,15}$')
        && getAfter(/databases/$(database)/documents/phoneIndex/$(request.resource.data.phone)).data.uid == me();
      allow update: if signedIn() && me() == uid
        && request.resource.data.phone == resource.data.phone;
      allow delete: if false;
    }

    match /phoneIndex/{phone} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me() && phone.matches('^[+][0-9]{8,15}$');
      allow update, delete: if false;
    }

    // ---- Chats (groups and 1:1)
    match /chats/{chatId} {
      allow read: if signedIn() && (
        resource == null
        || me() in resource.data.members
        || myPhone() in resource.data.pendingPhones
        || me() in resource.data.get('joinRequests', [])
      );

      allow create: if signedIn() && (
        // Group: creator is the only admin and a member.
        (request.resource.data.type == 'group'
          && request.resource.data.admins == [me()]
          && me() in request.resource.data.members
          && request.resource.data.createdBy == me())
        ||
        // 1:1 chat: id is derived from both uids.
        (request.resource.data.type == 'direct'
          && request.resource.data.members.size() == 2
          && me() in request.resource.data.members
          && chatId == 'dm_' + request.resource.data.members[0] + '_' + request.resource.data.members[1])
      );

      allow update: if signedIn() && (
        // Main admin (the group creator) manages everything, including who else is an admin.
        (resource.data.type == 'group' && me() == resource.data.createdBy && me() in resource.data.admins)
        ||
        // Second admins (appointed by the main admin) manage members, name, the group's UPI / fee settings, invite link…
        // but can't appoint/dismiss admins (only step down themselves), can't remove other admins or
        // the main admin, and can't change who the main admin is.
        (resource.data.type == 'group' && me() in resource.data.admins && me() != resource.data.createdBy
          && request.resource.data.createdBy == resource.data.createdBy
          && (!(resource.data.createdBy in resource.data.members) || resource.data.createdBy in request.resource.data.members)
          && (request.resource.data.admins.toSet() == resource.data.admins.toSet()
              || request.resource.data.admins.toSet() == resource.data.admins.toSet().difference([me()].toSet()))
          && resource.data.admins.toSet().difference([me()].toSet()).difference(request.resource.data.members.toSet()).size() == 0)
        ||
        // Ordinary members can NOT change the group's UPI ID or anything else — only the branches below.
        // Any member may bump the last-message preview.
        (me() in resource.data.members && changed().hasOnly(['lastMessage', 'updatedAt']))
        ||
        // A non-admin member may leave (remove only themselves).
        (resource.data.type == 'group' && me() in resource.data.members
          && changed().hasOnly(['members', 'admins'])
          && request.resource.data.members.toSet() == resource.data.members.toSet().difference([me()].toSet())
          && request.resource.data.admins.toSet() == resource.data.admins.toSet().difference([me()].toSet()))
        ||
        // Someone with the group's invite link joins (like WhatsApp): they can only add themselves,
        // and only by presenting the group's current invite code.
        (resource.data.type == 'group' && resource.data.get('inviteCode', '') != ''
          && changed().hasOnly(['members', 'lastJoinCode'])
          && request.resource.data.lastJoinCode == resource.data.inviteCode
          && request.resource.data.members.toSet() == resource.data.members.toSet().union([me()].toSet()))
        ||
        // An admin added this person's phone number before they had the app: once they register
        // with that number they join automatically (only themselves, only removing their own number).
        (resource.data.type == 'group' && myPhone() in resource.data.pendingPhones
          && changed().hasOnly(['members', 'pendingPhones'])
          && request.resource.data.members.toSet() == resource.data.members.toSet().union([me()].toSet())
          && request.resource.data.pendingPhones.toSet() == resource.data.pendingPhones.toSet().difference([myPhone()].toSet()))
        ||
        // Someone whose number was invited asks to join; a group admin must approve.
        (resource.data.type == 'group' && myPhone() in resource.data.pendingPhones
          && changed().hasOnly(['joinRequests'])
          && request.resource.data.joinRequests.toSet() == resource.data.get('joinRequests', []).toSet().union([me()].toSet()))
      );

      allow delete: if signedIn() && resource.data.type == 'group' && me() in resource.data.admins;

      match /messages/{msgId} {
        allow read: if isMemberOf(chatId);
        allow create: if isMemberOf(chatId) && request.resource.data.senderId == me();
        allow update, delete: if false;
      }

      // Attendance: admins mark, every member views.
      // Attendance is permanent history: admins mark and correct days, nobody can delete a day.
      match /attendance/{date} {
        allow read: if isMemberOf(chatId);
        allow create, update: if isAdminOf(chatId);
        allow delete: if false;
      }

      // Live location: once a member turns on location for this group, their phone keeps their point
      // here. Every member of THIS group can read it; each member writes only their own, and can
      // turn it off (delete) any time; admins can clear a stale point.
      match /locations/{uid} {
        allow read: if isMemberOf(chatId);
        allow create, update: if isMemberOf(chatId) && uid == me()
          && request.resource.data.keys().hasOnly(['lat', 'lng', 'accuracy', 'name', 'sharing', 'updatedAt'])
          && request.resource.data.lat is number && request.resource.data.lng is number
          && request.resource.data.sharing is bool;
        allow delete: if uid == me() || isAdminOf(chatId);
      }

      // Fees (older app versions, one record per member per month). Kept forever and still counted:
      // old app versions may still add a record, but nothing can rewrite or delete one.
      match /fees/{month}/payments/{uid} {
        allow read: if isMemberOf(chatId);
        allow create: if isAdminOf(chatId)
          || (isMemberOf(chatId) && uid == me()
              && request.resource.data.status == 'paid'
              && request.resource.data.method in ['upi', 'upi-manual']
              && request.resource.data.recordedBy == me());
        allow update, delete: if false;
      }

      // Fee ledger: every payment / correction is a NEW entry and stays forever (partial and advance
      // payments are worked out from it). Never deleted, never rewritten — except that an admin moves a
      // member's "pending" UTR payment to "confirmed" or "rejected" once.
      match /ledger/{entryId} {
        allow read: if isMemberOf(chatId);
        allow create: if isMemberOf(chatId)
          && request.resource.data.keys().hasOnly(['uid', 'kind', 'amount', 'forMonth', 'method', 'status', 'utr', 'reversalOf', 'note', 'recordedBy', 'createdAt', 'v'])
          && request.resource.data.uid is string
          && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000
          && request.resource.data.forMonth is string && request.resource.data.forMonth.matches('^[0-9]{4}-[0-9]{2}$')
          && request.resource.data.recordedBy == me()
          && request.resource.data.createdAt == request.time
          && (
            // Admins: payments (cash, UPI…) or corrections for any member of this group, confirmed.
            (isAdminOf(chatId) && request.resource.data.uid in chatData(chatId).members
              && request.resource.data.status == 'confirmed'
              && ((request.resource.data.kind == 'payment' && request.resource.data.reversalOf == null)
                  || (request.resource.data.kind == 'reversal' && request.resource.data.reversalOf is string)))
            ||
            // Members: only their own payment. 'upi' = the UPI app reported success; 'upi-manual' =
            // a UTR typed in, which waits for an admin, and each UTR can be used only once.
            (request.resource.data.uid == me() && request.resource.data.kind == 'payment' && request.resource.data.reversalOf == null
              && ((request.resource.data.method == 'upi' && request.resource.data.status == 'confirmed')
                  || (request.resource.data.method == 'upi-manual' && request.resource.data.status == 'pending'
                      && request.resource.data.utr is string
                      && getAfter(/databases/$(database)/documents/chats/$(chatId)/utrs/$(request.resource.data.utr)).data.entryId == entryId)))
          );
        allow update: if isAdminOf(chatId) && resource.data.status == 'pending'
          && request.resource.data.status in ['confirmed', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'verifiedBy', 'verifiedAt'])
          && request.resource.data.verifiedBy == me();
        allow delete: if false;
      }

      // A UTR (UPI reference) can be claimed once per group: created with its ledger entry, never changed.
      match /utrs/{utr} {
        allow read: if isMemberOf(chatId);
        allow create: if isMemberOf(chatId) && utr.matches('^[A-Z0-9]{8,30}$')
          && request.resource.data.keys().hasOnly(['entryId', 'uid', 'createdAt'])
          && (request.resource.data.uid == me() || isAdminOf(chatId))
          && existsAfter(/databases/$(database)/documents/chats/$(chatId)/ledger/$(request.resource.data.entryId));
        allow update, delete: if false;
      }
    }

    // ---- Invite links: anyone signed in who has the code can look up the group's name (no listing).
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && code.size() >= 12 && isAdminOf(request.resource.data.chatId);
      allow update: if signedIn() && isAdminOf(resource.data.chatId) && request.resource.data.chatId == resource.data.chatId;
      allow delete: if signedIn() && isAdminOf(resource.data.chatId);
    }

    // ---- Voice & video calls (signalling only; audio/video goes through Agora).
    // You can only ring people who are in the same chat as you: your gym group,
    // or the other person of a 1:1 chat (which any app user can open with any other app user).
    match /calls/{callId} {
      allow read: if signedIn() && (me() == resource.data.callerId || me() in resource.data.invited || me() in resource.data.get('ringingFor', []));
      allow create: if signedIn() && request.resource.data.callerId == me()
        && request.resource.data.kind in ['video', 'voice']
        && request.resource.data.status == 'ringing'
        && request.resource.data.joined == [me()]
        && request.resource.data.ringingFor == request.resource.data.invited
        && request.resource.data.invited.size() > 0
        && !(me() in request.resource.data.invited)
        && chatData(request.resource.data.chatId).members.hasAll(request.resource.data.invited.concat([me()]));
      allow update: if signedIn() && (me() == resource.data.callerId || me() in resource.data.invited)
        && changed().hasOnly(['joined', 'declined', 'ringingFor', 'status', 'endedAt']);
      allow delete: if false;
    }
  }
}
